# Copy to .env next to docker-compose.yml and fill these in. Do not commit .env.

# Required until the first admin exists. At least 16 characters; use a long random value,
# for example: openssl rand -base64 32
# After setup you can leave it set; it is ignored once an admin exists.
SETUP_SECRET=

# Public origin of your Drop, no trailing slash, e.g. https://drop.example.com.
# Invite links use it. Leave blank to use the host the request arrived on
# (X-Forwarded-Host behind a trusted proxy).
PUBLIC_URL=

# Host port docker-compose.yml publishes. Defaults to 8080.
DROP_PORT=

# true when the browser reaches Drop over HTTPS, including through a TLS-terminating proxy.
# docker-compose.yml defaults this to true.
COOKIE_SECURE=

# true behind a reverse proxy so X-Forwarded-* and X-Real-IP are used.
# docker-compose.yml defaults this to true.
TRUST_PROXY=

# Only for running outside Docker (npm start). The container uses /data, 8080, and 0.0.0.0.
DATA_DIR=
PORT=
HOST=
