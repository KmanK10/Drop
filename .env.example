# Copy to .env and fill these in. Do not commit .env.

# Required until the first admin exists. Use a long random value.
# After setup you can leave it set; it is ignored once an admin exists.
SETUP_SECRET=

# Public origin of the site, no trailing slash. Invite links use this.
PUBLIC_URL=https://drop.kiefermenard.com

# true when the browser reaches Drop over HTTPS, including through a TLS-terminating proxy.
COOKIE_SECURE=

# true behind a reverse proxy so X-Forwarded-* and X-Real-IP are used.
TRUST_PROXY=

DATA_DIR=
PORT=
HOST=
